{
  "name": "miseboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "codegen": "pnpm -r --if-present codegen",
    "codegen:check": "pnpm -r --if-present codegen:check",
    "db:generate": "pnpm -r --if-present db:generate",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "db:seed": "pnpm -r --if-present db:seed"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3"
  }
}
