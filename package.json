{
  "name": "miseboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "codegen": "pnpm --filter @miseboard/api schema:print && pnpm --filter @miseboard/schema codegen",
    "codegen:check": "pnpm -r --if-present codegen:check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm codegen:check",
    "db:generate": "pnpm -r --if-present db:generate",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "db:seed": "pnpm -r --if-present db:seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "codegen:watch": "pnpm --filter @miseboard/schema codegen:watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "~3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
