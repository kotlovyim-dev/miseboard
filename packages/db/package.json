{
  "name": "@miseboard/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/run-migrations.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed/run-seed.ts",
    "test": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@miseboard/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "~8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@miseboard/engine": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11",
    "graphql": "~16.14.2",
    "tsx": "~4.23.15",
    "vitest": "^5.0.5"
  }
}
